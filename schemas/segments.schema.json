{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segments.json — /learn-segment 的輸出",
  "type": "object",
  "required": [
    "video_id",
    "vision",
    "segments"
  ],
  "properties": {
    "video_id": {
      "type": "string"
    },
    "vision": {
      "type": "boolean"
    },
    "vision_reason": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "title",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "summary": {
            "type": "string"
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "t",
                "why"
              ],
              "properties": {
                "t": {
                  "type": "number"
                },
                "why": {
                  "type": "string"
                },
                "src": {
                  "type": "string",
                  "description": "來源是部落格時：文中圖片的網址（transcript.images[].src）；省略就取離 t 最近的那張"
                }
              }
            }
          },
          "clips": {
            "type": "array",
            "description": "這段值得原音重現的精華片段（聽力版用）；沒有就省略",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "why"
              ],
              "properties": {
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "why": {
                  "type": "string",
                  "description": "為什麼這段值得聽原音"
                },
                "translation": {
                  "type": "string",
                  "description": "這段原聲的中文翻譯（整段一段文字，術語保留英文原文）；輸出語言非中文時可省略"
                }
              }
            }
          }
        }
      }
    },
    "shots_mode": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "many"
      ],
      "description": "截圖策略：auto=只截看了才懂的畫面｜none=完全不截圖｜many=每段至少一張"
    },
    "max_shots": {
      "type": "integer",
      "minimum": 0,
      "description": "整支影片的截圖上限；省略時用 config/estimate.yaml 的 shot.max_frames（many 模式 max_frames_many）"
    }
  }
}
