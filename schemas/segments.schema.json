{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segments.json — /learn-segment 的輸出",
  "type": "object",
  "required": ["video_id", "vision", "segments"],
  "properties": {
    "video_id": {"type": "string"},
    "vision": {"type": "boolean"},
    "vision_reason": {"type": "string"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "title", "summary"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "title": {"type": "string", "maxLength": 40},
          "summary": {"type": "string"},
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t", "why"],
              "properties": {"t": {"type": "number"}, "why": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
