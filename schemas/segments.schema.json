{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "segments.json — /learn-segment 的輸出",
  "type": "object",
  "required": [
    "video_id",
    "vision",
    "segments"
  ],
  "properties": {
    "video_id": {
      "type": "string"
    },
    "vision": {
      "type": "boolean"
    },
    "vision_reason": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "title",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "summary": {
            "type": "string"
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "t",
                "why"
              ],
              "properties": {
                "t": {
                  "type": "number"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "clips": {
            "type": "array",
            "description": "這段值得原音重現的精華片段（聽力版用）；沒有就省略",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "why"
              ],
              "properties": {
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "why": {
                  "type": "string",
                  "description": "為什麼這段值得聽原音"
                },
                "translation": {
                  "type": "string",
                  "description": "這段原聲的中文翻譯（整段一段文字，術語保留英文原文）；輸出語言非中文時可省略"
                }
              }
            }
          }
        }
      }
    },
    "shots_mode": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "many"
      ],
      "description": "截圖策略：auto=只截看了才懂的畫面｜none=完全不截圖｜many=每段至少一張"
    }
  }
}