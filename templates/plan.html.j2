<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ overview.topic }} — 學習規劃</title>
<style>
  :root { --fg:#1f2328; --muted:#59636e; --bg:#fff; --card:#f6f8fa; --line:#d0d7de; --accent:#0969da; --overlay:rgba(0,0,0,.85);
          --wrong:#cf222e; --wrong-bg:#ffebe9; --debat:#bc4c00; --debat-bg:#fff1e5; }
  @media (prefers-color-scheme: dark) {
    :root { --fg:#e6edf3; --muted:#9198a1; --bg:#0d1117; --card:#161b22; --line:#30363d; --accent:#4493f8; --overlay:rgba(0,0,0,.9);
            --wrong:#ff7b72; --wrong-bg:#3c1618; --debat:#f0883e; --debat-bg:#3a2210; }
  }
  body { margin:0; padding:2rem 1rem; background:var(--bg); color:var(--fg);
         font:16px/1.7 system-ui, "Noto Sans TC", sans-serif; }
  main { max-width: 900px; margin: 0 auto; }
  h1 { font-size:1.9rem; } h2 { border-bottom:1px solid var(--line); padding-bottom:.3rem; margin-top:3rem; }
  h3 { margin-top:2rem; } h4 { margin:1.5rem 0 .3rem; color:var(--accent); }
  .muted { color:var(--muted); font-size:.9rem; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:1rem 1.2rem; margin:1rem 0; }
  .seg { border-left:3px solid var(--accent); padding-left:1rem; margin:2rem 0; }
  .bridge { background:var(--card); border-radius:6px; padding:.5rem .8rem; margin:.5rem 0; }
  .bridge b { color:var(--accent); }
  .tag { display:inline-block; font-size:.72rem; font-weight:600; letter-spacing:.02em; padding:.05rem .5rem;
         border-radius:999px; margin-right:.4rem; vertical-align:.1em; white-space:nowrap; }
  .tag.r { background:var(--accent); color:#fff; }
  .tag.ai { background:var(--card); color:var(--accent); border:1px solid var(--accent); }
  /* 勘誤／過時 */
  .issues { margin:.8rem 0; }
  .issue { border-left:4px solid; border-radius:6px; padding:.5rem .8rem; margin:.5rem 0; }
  .issue.wrong { border-color:var(--wrong); background:var(--wrong-bg); }
  .issue.debatable { border-color:var(--debat); background:var(--debat-bg); }
  .issue .lvl { display:inline-block; font-size:.72rem; font-weight:700; padding:.05rem .5rem; border-radius:999px; color:#fff; margin-right:.4rem; }
  .issue.wrong .lvl { background:var(--wrong); } .issue.debatable .lvl { background:var(--debat); }
  .issue blockquote { margin:.3rem 0; padding-left:.6rem; border-left:2px solid var(--line); color:var(--muted); font-style:italic; }
  .issue .ev { font-size:.85rem; color:var(--muted); }
  table.issues-sum td { vertical-align:top; } table.issues-sum td.q { color:var(--muted); font-style:italic; max-width:24rem; }
  table.issues-sum tr.wrong td:first-child { border-left:4px solid var(--wrong); }
  table.issues-sum tr.debatable td:first-child { border-left:4px solid var(--debat); }
  .legend-issues span { margin-right:1rem; } .legend-issues i { display:inline-block; width:.8rem; height:.8rem; border-radius:3px; margin-right:.3rem; vertical-align:-.05em; }
  .frames { display:flex; flex-wrap:wrap; gap:.6rem; }
  .frames figure { margin:0; max-width:280px; }
  .frames img { width:100%; border:1px solid var(--line); border-radius:4px; cursor:zoom-in; }
  .frames figcaption { font-size:.8rem; color:var(--muted); }
  table { border-collapse:collapse; font-size:.9rem; } td,th { border:1px solid var(--line); padding:.2rem .6rem; }
  a { color:var(--accent); }
  code { background:var(--card); padding:.1rem .35rem; border-radius:4px; }

  /* mermaid：可點開全視窗 */
  .mm-wrap { position:relative; border:1px dashed var(--line); border-radius:8px; padding:.5rem; cursor:zoom-in; overflow-x:auto; }
  .mm-wrap::after { content:"⤢ 點擊放大"; position:absolute; right:.6rem; top:.4rem; font-size:.75rem; color:var(--muted); }
  .mm-wrap:hover { border-color:var(--accent); }
  .mm-wrap svg { max-width:100%; height:auto; }
  .mm-wrap svg[width] { max-width:none; height:auto; }   /* flowchart：不縮小，寬了就橫向捲 */
  .legend { display:flex; flex-wrap:wrap; gap:.3rem .9rem; font-size:.85rem; color:var(--muted); margin:.2rem 0 .5rem; }
  .legend i { display:inline-block; width:.8rem; height:.8rem; border-radius:3px; margin-right:.3rem; vertical-align:-.05em; }
  .mindmap-node text, .mindmap-node tspan { font-size:15px !important; }
  .mindmap-node .section-root text { font-size:18px !important; font-weight:700; }
  /* 圖的文字描述，預設收合 */
  details.desc { margin:.4rem 0 1.2rem; border:1px solid var(--line); border-radius:8px; background:var(--card); }
  details.desc summary { cursor:pointer; padding:.4rem .8rem; color:var(--muted); font-size:.9rem; user-select:none; }
  details.desc[open] summary { border-bottom:1px solid var(--line); }
  details.desc > div { padding:.6rem 1rem; font-size:.92rem; overflow-x:auto; }
  details.desc ol, details.desc ul { margin:.2rem 0; padding-left:1.4rem; }

  /* 術語：原文 + hover 中文 + ⓘ */
  dl.terms dt { font-weight:600; margin-top:.5rem; display:flex; align-items:center; gap:.4rem; }
  dl.terms dd { margin:0 0 0 1rem; }
  .term { position:relative; border-bottom:1px dotted var(--muted); cursor:help; }
  .term::after { content:attr(data-zh); position:absolute; left:0; bottom:calc(100% + 4px); white-space:nowrap;
                 background:var(--fg); color:var(--bg); font-size:.8rem; font-weight:400; padding:.15rem .5rem;
                 border-radius:4px; opacity:0; pointer-events:none; transition:opacity .12s; z-index:5; }
  .term:hover::after { opacity:1; }
  .info { display:inline-flex; align-items:center; justify-content:center; width:1.15rem; height:1.15rem;
          border-radius:50%; border:1px solid var(--accent); color:var(--accent); background:none;
          font:700 .75rem/1 system-ui; cursor:pointer; padding:0; }
  .info:hover { background:var(--accent); color:#fff; }
  dialog { border:1px solid var(--line); border-radius:10px; background:var(--bg); color:var(--fg);
           max-width:560px; width:calc(100% - 2rem); padding:1.2rem 1.5rem; }
  dialog::backdrop { background:rgba(0,0,0,.5); }
  dialog h3 { margin:0 0 .2rem; } dialog .zh { color:var(--muted); margin-bottom:.8rem; }
  dialog .close { float:right; border:none; background:none; color:var(--muted); font-size:1.2rem; cursor:pointer; }

  /* 全視窗 viewer（mermaid + lightbox 共用） */
  #viewer { position:fixed; inset:0; background:var(--overlay); z-index:100; display:flex; flex-direction:column; }
  #viewer[hidden] { display:none; }
  .v-bar { display:flex; align-items:center; gap:.4rem; padding:.5rem .8rem; color:#fff; font-size:.9rem;
           background:rgba(0,0,0,.4); }
  .v-bar .cap { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .v-bar button { background:rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.3);
                  border-radius:4px; padding:.2rem .6rem; cursor:pointer; font-size:.9rem; }
  .v-bar button:hover { background:rgba(255,255,255,.25); }
  .v-stage { flex:1; overflow:hidden; position:relative; cursor:grab; touch-action:none; user-select:none; -webkit-user-select:none; }
  .v-stage.drag { cursor:grabbing; }
  .v-content { position:absolute; left:0; top:0; transform-origin:0 0; will-change:transform; }
  .v-content img { display:block; max-width:none; }
  .v-content svg { display:block; background:var(--bg); border-radius:6px; }
  .v-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(0,0,0,.5); color:#fff;
           border:none; font-size:2rem; padding:.4rem .7rem; cursor:pointer; border-radius:6px; }
  .v-nav.prev { left:.5rem; } .v-nav.next { right:.5rem; }
  .v-nav[hidden] { display:none; }
</style>
</head>
<body>
<main>
<h1>{{ overview.topic }}</h1>
<p class="muted">學習規劃 · {{ videos|length }} 支影片 · 產生於 {{ generated }}</p>

<!-- 1 -->
<h2>1. 前情提要 &amp; Outline</h2>
<div class="card">
  <h4>看之前需要先懂</h4>
  <ul>{% for p in overview.prerequisites %}<li><b>{{ p.concept }}</b> — {{ p.note }}</li>{% endfor %}</ul>
</div>
<h4>Outline</h4>
<ol>
{% for o in overview.outline %}
  {% set v = (videos | selectattr('id', 'equalto', o.video_id) | list | first) %}
  <li><b>{{ o.role }}</b> · {% if v %}<a href="#v-{{ o.video_id }}">{{ v.meta.title }}</a>{% else %}{{ o.video_id }}{% endif %}<br>{{ o.line }}</li>
{% endfor %}
</ol>

<!-- 2 -->
<h2>2. YouTuber 的思維推導</h2>
{% for v in videos %}
<h3 id="v-{{ v.id }}">{{ v.meta.title }}</h3>
<p class="muted">
  {{ v.meta.channel }} · {{ v.meta.duration|dur }} · 字幕 {{ v.meta.transcript_lang }} ·
  vision={{ 'on' if v.analysis.vision_used else 'off' }}
  {% if v.segments.vision_reason %}（{{ v.segments.vision_reason }}）{% endif %} ·
  <a href="{{ v.meta.url }}" target="_blank" rel="noopener">YouTube</a>
</p>
{% if v.estimate or v.timings %}
<table><tr><th>階段</th><th>預估</th><th>實際</th></tr>
{% for st in ['fetch','segment','shot','analyze','render'] %}
<tr><td>{{ st }}</td>
  <td>{{ v.estimate.stages[st].sec|dur if v.estimate and st in v.estimate.stages else '–' }}</td>
  <td>{{ v.timings[st].sec|dur if st in v.timings else '–' }}</td></tr>
{% endfor %}</table>
{% endif %}
<p>{{ v.analysis.author_reasoning }}</p>
<div class="mm-wrap" data-cap="推理鏈 · {{ v.meta.title }}"><pre class="mermaid">
{{ v.chain_mermaid }}
</pre></div>
<details class="desc"><summary>推理鏈的文字說明</summary><div>
  <p class="muted">每個節點是一段，箭頭上的字是該段留給下一段的線索。hover 節點看該段摘要、hover 箭頭文字看完整線索。</p>
  <ol>{% for c in v.chain_desc %}<li><a href="#{{ v.id }}-s{{ c.id }}">{{ c.title }}</a>{% if not loop.last %} → <i>{{ c.leads_to }}</i>{% endif %}</li>{% endfor %}</ol>
</div></details>
{% endfor %}

<!-- 3 -->
<h2>3. 逐段說明</h2>
{% for v in videos %}
<h3>{{ v.meta.title }}</h3>
{% for s in v.analysis.segments %}
<section class="seg" id="{{ v.id }}-s{{ s.id }}">
  <h4>{{ s.id }}. {{ s.title }} <span class="muted"><a href="{{ v.meta.url }}&t={{ s.start|int }}s" target="_blank" rel="noopener">{{ s.start|ts }}</a>–{{ s.end|ts }}</span></h4>
  {% if s.summary %}<p><i>作者說：</i>{{ s.summary }}</p>{% endif %}
  {% if s.shots %}
  <div class="frames">
    {% for sh in s.shots %}<figure><img src="{{ sh.href }}" alt="{{ sh.why }}" loading="lazy" data-video="{{ v.id }}" data-idx="{{ sh.idx }}"><figcaption>{{ sh.t|ts }} · {{ sh.why }}</figcaption></figure>{% endfor %}
  </div>
  {% endif %}
  <div class="bridge"><b>承上</b> {{ s.builds_on }}</div>
  <p><span class="tag r">推理</span>{{ s.reasoning }}</p>
  {% if s.explanation %}<p><span class="tag ai">AI 補充</span>{{ s.explanation }}</p>{% endif %}
  {% if s.terms %}
  <dl class="terms">
    {% for t in s.terms %}
    {% set tid = v.id ~ '-' ~ s.id ~ '-' ~ loop.index %}
    <dt><span class="term" data-zh="{{ t.zh }}">{{ t.term }}</span><button class="info" data-term="{{ tid }}" title="更多說明" aria-label="更多說明">i</button></dt>
    <dd>{{ t.definition }}{% if t.related %} <span class="muted">相關：{% for r in t.related %}{{ r.term if r is mapping else r }}{% if not loop.last %}、{% endif %}{% endfor %}</span>{% endif %}</dd>
    <dialog id="term-{{ tid }}">
      <button class="close" data-close aria-label="關閉">✕</button>
      <h3>{{ t.term }}</h3>
      <div class="zh">{{ t.zh }}</div>
      <p>{{ t.definition }}</p>
      {% if t.more %}<p>{{ t.more }}</p>{% endif %}
      {% if t.related %}<p class="muted">相關術語：{% for r in t.related %}{{ r.term if r is mapping else r }}{% if r is mapping and r.rel %}（{{ r.rel }}）{% endif %}{% if not loop.last %}、{% endif %}{% endfor %}</p>{% endif %}
      <p class="muted">出處：第 {{ s.id }} 段「{{ s.title }}」</p>
    </dialog>
    {% endfor %}
  </dl>
  {% endif %}
  {% if s.issues %}
  <div class="issues">
    {% for iss in s.issues %}
    <div class="issue {{ iss.level }}">
      <span class="lvl">{{ '確定錯誤／已過時' if iss.level == 'wrong' else '見仁見智' }}</span>
      <a href="{{ v.meta.url }}&t={{ iss.t|int }}s" target="_blank" rel="noopener" class="muted">{{ iss.t|ts }}</a>
      <blockquote>「{{ iss.quote }}」</blockquote>
      <div>{{ iss.note }}</div>
      {% if iss.evidence %}<div class="ev">依據：{{ iss.evidence }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="bridge"><b>留給下一段</b> {{ s.leads_to }}</div>
</section>
{% endfor %}
{% endfor %}

<!-- 4 -->
<h2>4. 總結</h2>
<p>{{ overview.summary }}</p>
{% set all_issues = videos | map(attribute='issues') | sum(start=[]) %}
{% if all_issues %}
<h4>勘誤總整理</h4>
<p class="legend-issues muted"><span><i style="background:var(--wrong)"></i>確定錯誤／已過時</span><span><i style="background:var(--debat)"></i>見仁見智（取決於版本或情境）</span></p>
<div style="overflow-x:auto"><table class="issues-sum">
<tr><th>段落</th><th>原話（transcript 逐字）</th><th>說明</th></tr>
{% for v in videos %}{% for iss in v.issues %}
<tr class="{{ iss.level }}"><td><a href="#{{ v.id }}-s{{ iss.seg_id }}">{{ iss.seg_id }}. {{ iss.seg_title }}</a><br><span class="muted">{{ iss.t|ts }}</span></td>
<td class="q">「{{ iss.quote }}」</td><td>{{ iss.note }}{% if iss.evidence %}<br><span class="ev">依據：{{ iss.evidence }}</span>{% endif %}</td></tr>
{% endfor %}{% endfor %}
</table></div>
{% endif %}
<div class="mm-wrap" data-cap="Mindmap"><pre class="mermaid">
{{ mindmap }}
</pre></div>
<details class="desc"><summary>Mindmap 的文字說明</summary><div>
  <p class="muted">根 = 主題；第二層 = 影片；第三層 = 段落；第四層 = 該段首次定義的術語。</p>
  <ul><li><b>{{ overview.topic }}</b>
    <ul>{% for v in videos %}<li>{{ v.meta.title }}
      <ul>{% for s in v.analysis.segments %}<li><a href="#{{ v.id }}-s{{ s.id }}">{{ s.id }}. {{ s.title }}</a>{% if s.terms %} — {{ s.terms|map(attribute='term')|join('、') }}{% endif %}</li>{% endfor %}</ul>
    </li>{% endfor %}</ul>
  </li></ul>
</div></details>
{% if term_graph %}
<h4>術語關聯圖</h4>
<p class="legend">{% for g in term_legend %}<span><i style="background:{{ g.color }}"></i>{{ g.title }}</span>{% endfor %}</p>
<div class="mm-wrap" data-cap="術語關聯圖"><pre class="mermaid">
{{ term_graph }}
</pre></div>
<details class="desc"><summary>術語關聯圖的文字說明</summary><div>
  <p class="muted">節點顏色 = 首次定義的段落（見上方圖例）；箭頭 A → B 表示 A 的定義牽涉 B，線上文字是關係；雙箭頭且標籤前有 ⇄ = 兩者定義互相引用。hover 節點看定義、hover 線上文字看完整關係。</p>
  <ul>{% for e in term_edges %}<li><b>{{ e.a }}</b> {{ '⇄' if e.both else '→' }} <b>{{ e.b }}</b>{% if e.rel %}：{{ e.a }} → {{ e.b }} {{ e.rel }}{% endif %}{% if e.both and e.rel_back %}；{{ e.b }} → {{ e.a }} {{ e.rel_back }}{% endif %}</li>{% endfor %}</ul>
</div></details>
{% endif %}

<!-- 5 -->
<h2>5. 推薦三個下一步</h2>
{% for n in overview.next_steps %}
<div class="card">
  <h4>{{ loop.index }}. {{ n.direction }}</h4>
  <p>{{ n.why }}</p>
  <p>YouTube 搜尋：{% for k in n.search_keywords %}<a href="{{ k|yt_search }}" target="_blank" rel="noopener"><code>{{ k }}</code></a>{{ ' ' }}{% endfor %}</p>
</div>
{% endfor %}

</main>

<!-- 全視窗 viewer -->
<div id="viewer" hidden>
  <div class="v-bar">
    <span class="cap"></span>
    <button data-act="zoomout" title="縮小 (-)">−</button>
    <button data-act="zoomin" title="放大 (+)">+</button>
    <button data-act="fit" title="最佳視角 (F)">Fit</button>
    <button data-act="reset" title="原始大小 (1)">1:1</button>
    <button data-act="close" title="關閉 (Esc)">✕</button>
  </div>
  <div class="v-stage">
    <div class="v-content"></div>
    <button class="v-nav prev" data-act="prev" hidden title="上一張 (←)">‹</button>
    <button class="v-nav next" data-act="next" hidden title="下一張 (→)">›</button>
  </div>
</div>

<script id="shots-data" type="application/json">{{ videos | map(attribute='all_shots') | list | tojson }}</script>
<script id="tips-data" type="application/json">{{ tips | tojson }}</script>
<script id="shots-ids" type="application/json">{{ videos | map(attribute='id') | list | tojson }}</script>

<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
  const dark = matchMedia("(prefers-color-scheme: dark)").matches;
  mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "default",
    flowchart: { useMaxWidth: false, htmlLabels: true }, mindmap: { useMaxWidth: true } });
  await mermaid.run({ querySelector: ".mermaid" });

  /* mindmap 配色：不吃 mermaid 主題，依 section 上色，線與節點同色，深淺主題都看得清 */
  const PALETTE = ["#4e79a7", "#f28e2b", "#59a14f", "#e15759", "#b07aa1", "#76b7b2", "#edc948", "#ff9da7", "#9c755f", "#bab0ac"];
  const css = getComputedStyle(document.documentElement);
  const fg = css.getPropertyValue("--fg").trim(), bg = css.getPropertyValue("--bg").trim(), accent = css.getPropertyValue("--accent").trim();
  const sectionOf = (el) => { const m = (el.getAttribute("class") || "").match(/section-(?:edge-)?(-?\d+)/); return m ? +m[1] : null; };
  const colorOf = (sec) => sec === null || sec < 0 ? accent : PALETTE[sec % PALETTE.length];
  const setImp = (el, props) => Object.entries(props).forEach(([k, v]) => el.style.setProperty(k, v, "important"));
  const paintMindmap = (svg) => {
    // mermaid 主題用 !important 上色，所以這裡也要 !important 才蓋得掉
    svg.querySelectorAll(".mindmap-edges path, path.edge").forEach((p) => {
      setImp(p, { stroke: colorOf(sectionOf(p)), "stroke-width": "2.5px", "stroke-opacity": ".75", fill: "none" });
    });
    svg.querySelectorAll(".mindmap-node").forEach((n) => {
      const sec = sectionOf(n), c = colorOf(sec), isRoot = sec === null || sec < 0;
      n.querySelectorAll("rect, circle, path, polygon").forEach((sh) => {
        setImp(sh, { fill: isRoot ? c : `color-mix(in srgb, ${c} 28%, ${bg})`, "fill-opacity": "1", stroke: c, "stroke-width": "2px" });
      });
      n.querySelectorAll("text, tspan").forEach((t) => setImp(t, { fill: isRoot ? "#fff" : fg }));
      n.querySelectorAll("foreignObject span, foreignObject div, foreignObject p").forEach((t) => setImp(t, { color: isRoot ? "#fff" : fg }));
    });
  };
  document.querySelectorAll(".mermaid svg").forEach((svg) => { if (svg.querySelector(".mindmap-node")) paintMindmap(svg); });

  /* hover 顯示完整文字：短標籤 → 完整說明（render.py 產生的對照表），用 SVG <title> */
  const TIPS = JSON.parse(document.getElementById("tips-data").textContent);
  const SVGNS = "http://www.w3.org/2000/svg";
  const addTitle = (g, text) => { const t = document.createElementNS(SVGNS, "title"); t.textContent = text; g.prepend(t); };
  document.querySelectorAll(".mermaid svg").forEach((svg) => {
    svg.querySelectorAll(".node, .mindmap-node, .edgeLabel, .cluster").forEach((g) => {
      if (g.querySelector(":scope > title")) return;
      const key = (g.textContent || "").replace(/\s+/g, "");
      if (TIPS[key]) addTitle(g, TIPS[key]);
    });
    // mindmap 的線 = 上下層包含關係
    svg.querySelectorAll(".mindmap-edges path, path.edge.section-edge-0, path[class*='section-edge-']").forEach((p) => {
      if (!p.querySelector("title")) addTitle(p, "上層 → 下層：段落包含在此段首次定義的術語");
    });
  });

  /* ---------- viewer：pan / zoom / fit，mermaid 與截圖共用 ---------- */
  const V = {
    el: document.getElementById("viewer"),
    stage: document.querySelector("#viewer .v-stage"),
    content: document.querySelector("#viewer .v-content"),
    cap: document.querySelector("#viewer .cap"),
    prev: document.querySelector("#viewer .prev"),
    next: document.querySelector("#viewer .next"),
    items: [], idx: 0, s: 1, tx: 0, ty: 0, w: 0, h: 0,
  };
  const apply = () => V.content.style.transform = `translate(${V.tx}px,${V.ty}px) scale(${V.s})`;
  const fit = () => {
    const sw = V.stage.clientWidth, sh = V.stage.clientHeight;
    V.s = Math.min(sw / V.w, sh / V.h) * 0.95;
    V.tx = (sw - V.w * V.s) / 2; V.ty = (sh - V.h * V.s) / 2; apply();
  };
  const reset = () => { V.s = 1; V.tx = (V.stage.clientWidth - V.w) / 2; V.ty = (V.stage.clientHeight - V.h) / 2; apply(); };
  const zoomAt = (f, cx, cy) => {
    const ns = Math.min(20, Math.max(0.05, V.s * f));
    V.tx = cx - (cx - V.tx) * (ns / V.s); V.ty = cy - (cy - V.ty) * (ns / V.s); V.s = ns; apply();
  };
  const show = (i) => {
    V.idx = (i + V.items.length) % V.items.length;
    const it = V.items[V.idx];
    V.content.replaceChildren();
    V.cap.textContent = (V.items.length > 1 ? `${V.idx + 1}/${V.items.length} · ` : "") + it.caption;
    V.prev.hidden = V.next.hidden = V.items.length < 2;
    if (it.type === "svg") {
      const svg = it.node.cloneNode(true);
      const vb = svg.viewBox.baseVal;
      V.w = vb.width || svg.width.baseVal.value || 800; V.h = vb.height || svg.height.baseVal.value || 600;
      svg.removeAttribute("style"); svg.setAttribute("width", V.w); svg.setAttribute("height", V.h);
      V.content.appendChild(svg); fit();
    } else {
      const img = new Image();
      img.onload = () => { V.w = img.naturalWidth; V.h = img.naturalHeight; V.content.appendChild(img); fit(); };
      img.src = it.src;
    }
  };
  const open = (items, i = 0) => { V.items = items; V.el.hidden = false; show(i); };
  const close = () => { V.el.hidden = true; V.content.replaceChildren(); };

  V.el.addEventListener("click", (e) => {
    const act = e.target.closest("[data-act]")?.dataset.act;
    if (!act) return;
    ({ zoomin: () => zoomAt(1.25, V.stage.clientWidth / 2, V.stage.clientHeight / 2),
       zoomout: () => zoomAt(0.8, V.stage.clientWidth / 2, V.stage.clientHeight / 2),
       fit, reset, close, prev: () => show(V.idx - 1), next: () => show(V.idx + 1) })[act]();
  });
  V.stage.addEventListener("wheel", (e) => {
    e.preventDefault();
    const r = V.stage.getBoundingClientRect();
    zoomAt(e.deltaY < 0 ? 1.1 : 1 / 1.1, e.clientX - r.left, e.clientY - r.top);
  }, { passive: false });
  let drag = null;
  V.stage.addEventListener("pointerdown", (e) => {
    if (e.target.closest("button")) return;
    drag = { x: e.clientX - V.tx, y: e.clientY - V.ty }; V.stage.classList.add("drag"); V.stage.setPointerCapture(e.pointerId);
  });
  V.stage.addEventListener("pointermove", (e) => { if (drag) { V.tx = e.clientX - drag.x; V.ty = e.clientY - drag.y; apply(); } });
  V.stage.addEventListener("pointerup", () => { drag = null; V.stage.classList.remove("drag"); });
  V.stage.addEventListener("dblclick", (e) => { const r = V.stage.getBoundingClientRect(); zoomAt(1.6, e.clientX - r.left, e.clientY - r.top); });
  addEventListener("keydown", (e) => {
    if (V.el.hidden) return;
    const k = { Escape: close, ArrowLeft: () => show(V.idx - 1), ArrowRight: () => show(V.idx + 1),
                "+": () => zoomAt(1.25, V.stage.clientWidth / 2, V.stage.clientHeight / 2), "=": () => zoomAt(1.25, V.stage.clientWidth / 2, V.stage.clientHeight / 2),
                "-": () => zoomAt(0.8, V.stage.clientWidth / 2, V.stage.clientHeight / 2), f: fit, F: fit, "1": reset, "0": fit }[e.key];
    if (k) { e.preventDefault(); k(); }
  });
  addEventListener("resize", () => { if (!V.el.hidden) fit(); });

  /* mermaid → viewer */
  document.querySelectorAll(".mm-wrap").forEach((w) => {
    w.addEventListener("click", () => {
      const svg = w.querySelector("svg"); if (!svg) return;
      open([{ type: "svg", node: svg, caption: w.dataset.cap || "" }]);
    });
  });

  /* 截圖 → lightbox：輪流同一支影片的所有截圖 */
  const shotsByVideo = JSON.parse(document.getElementById("shots-data").textContent);
  const videoIds = JSON.parse(document.getElementById("shots-ids").textContent);
  const fmtTs = (s) => { s = Math.floor(s); const m = Math.floor(s / 60), r = s % 60; return `${m}:${String(r).padStart(2, "0")}`; };
  document.querySelectorAll(".frames img").forEach((img) => {
    img.addEventListener("click", () => {
      const shots = shotsByVideo[videoIds.indexOf(img.dataset.video)];
      open(shots.map((sh) => ({ type: "img", src: sh.href, caption: `${sh.seg_title} · ${fmtTs(sh.t)} · ${sh.why}` })), +img.dataset.idx);
    });
  });

  /* 術語 ⓘ → dialog */
  document.querySelectorAll(".info[data-term]").forEach((b) => {
    b.addEventListener("click", () => document.getElementById("term-" + b.dataset.term).showModal());
  });
  document.querySelectorAll("dialog").forEach((d) => {
    d.querySelector("[data-close]").addEventListener("click", () => d.close());
    d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
  });
</script>
</body>
</html>
