{% extends "_base.html.j2" %}
{% block title %}{{ overview.topic }} — 學習規劃{% endblock %}
{% block css %}
  .seg { border-left:3px solid var(--accent); padding-left:1rem; margin:2rem 0; }
  .bridge { background:var(--card); border-radius:6px; padding:.5rem .8rem; margin:.5rem 0; }
  .bridge b { color:var(--accent); }
  .tag { display:inline-block; font-size:.72rem; font-weight:600; letter-spacing:.02em; padding:.05rem .5rem;
         border-radius:999px; margin-right:.4rem; vertical-align:.1em; white-space:nowrap; }
  .tag.r { background:var(--accent); color:#fff; }
  .tag.ai { background:var(--card); color:var(--accent); border:1px solid var(--accent); }
  .atlas-nav ul { margin:.3rem 0 0; padding-left:1.2rem; }
  .atlas-nav .rt { display:inline-block; font-size:.72rem; font-weight:700; padding:0 .45rem; border-radius:999px; background:var(--accent); color:#fff; margin-right:.4rem; }
  /* 勘誤／過時 */
  .issues { margin:.8rem 0; }
  .issue { border-left:4px solid; border-radius:6px; padding:.5rem .8rem; margin:.5rem 0; }
  .issue.wrong { border-color:var(--wrong); background:var(--wrong-bg); }
  .issue.debatable { border-color:var(--debat); background:var(--debat-bg); }
  .issue .lvl { display:inline-block; font-size:.72rem; font-weight:700; padding:.05rem .5rem; border-radius:999px; color:#fff; margin-right:.4rem; }
  .issue.wrong .lvl { background:var(--wrong); } .issue.debatable .lvl { background:var(--debat); }
  .issue blockquote { margin:.3rem 0; padding-left:.6rem; border-left:2px solid var(--line); color:var(--muted); font-style:italic; }
  .issue .ev { font-size:.85rem; color:var(--muted); }
  table.issues-sum td { vertical-align:top; } table.issues-sum td.q { color:var(--muted); font-style:italic; max-width:24rem; }
  table.issues-sum tr.wrong td:first-child { border-left:4px solid var(--wrong); }
  table.issues-sum tr.debatable td:first-child { border-left:4px solid var(--debat); }
  .legend-issues span { margin-right:1rem; } .legend-issues i { display:inline-block; width:.8rem; height:.8rem; border-radius:3px; margin-right:.3rem; vertical-align:-.05em; }
  .frames { display:flex; flex-wrap:wrap; gap:.6rem; }
  .frames figure { margin:0; max-width:280px; }
  .frames img { width:100%; border:1px solid var(--line); border-radius:4px; cursor:zoom-in; }
  .frames figcaption { font-size:.8rem; color:var(--muted); }
  /* 術語：原文 + hover 中文 + ⓘ */
  dl.terms dt { font-weight:600; margin-top:.5rem; display:flex; align-items:center; gap:.4rem; }
  dl.terms dd { margin:0 0 0 1rem; }
  .term { position:relative; border-bottom:1px dotted var(--muted); cursor:help; }
  .term::after { content:attr(data-zh); position:absolute; left:0; bottom:calc(100% + 4px); white-space:nowrap;
                 background:var(--fg); color:var(--bg); font-size:.8rem; font-weight:400; padding:.15rem .5rem;
                 border-radius:4px; opacity:0; pointer-events:none; transition:opacity .12s; z-index:5; }
  .term:hover::after { opacity:1; }
  .info { display:inline-flex; align-items:center; justify-content:center; width:1.15rem; height:1.15rem;
          border-radius:50%; border:1px solid var(--accent); color:var(--accent); background:none;
          font:700 .75rem/1 system-ui; cursor:pointer; padding:0; }
  .info:hover { background:var(--accent); color:#fff; }
  dialog { border:1px solid var(--line); border-radius:10px; background:var(--bg); color:var(--fg);
           max-width:560px; width:calc(100% - 2rem); padding:1.2rem 1.5rem; }
  dialog::backdrop { background:rgba(0,0,0,.5); }
  dialog h3 { margin:0 0 .2rem; } dialog .zh { color:var(--muted); margin-bottom:.8rem; }
  dialog .close { float:right; border:none; background:none; color:var(--muted); font-size:1.2rem; cursor:pointer; }
{% endblock %}
{% block body %}
<main>
<h1>{{ overview.topic }}</h1>
<p class="muted">學習規劃 · {{ videos|length }} 支影片 · 產生於 {{ generated }}</p>
{% if atlas %}
<div class="card atlas-nav">
  <b>🗺 <a href="{{ atlas.atlas_href }}">學習地圖</a></b>
  {% if atlas.region %} · 主題區：<b>{{ atlas.region.name }}</b>{% endif %}
  {% if atlas.links %}
  <ul>{% for l in atlas.links %}<li><span class="rt">{{ l.type }} {{ l.dir }}</span><a href="{{ l.href }}">{{ l.title }}</a> <span class="muted">· {{ l.via }}</span></li>{% endfor %}</ul>
  {% else %}<div class="muted">這一站還沒有連到其他站。</div>{% endif %}
</div>
{% endif %}

<!-- 1 -->
<h2>1. 前情提要 &amp; Outline</h2>
<div class="card">
  <h4>看之前需要先懂</h4>
  <ul>{% for p in overview.prerequisites %}<li><b>{{ p.concept }}</b> — {{ p.note }}</li>{% endfor %}</ul>
</div>
<h4>Outline</h4>
<ol>
{% for o in overview.outline %}
  {% set v = (videos | selectattr('id', 'equalto', o.video_id) | list | first) %}
  <li><b>{{ o.role }}</b> · {% if v %}<a href="#v-{{ o.video_id }}">{{ v.meta.title }}</a>{% else %}{{ o.video_id }}{% endif %}<br>{{ o.line }}</li>
{% endfor %}
</ol>

<!-- 2 -->
<h2>2. YouTuber 的思維推導</h2>
{% for v in videos %}
<h3 id="v-{{ v.id }}">{{ v.meta.title }}</h3>
<p class="muted">
  {{ v.meta.channel }} · {{ v.meta.duration|dur }} · 字幕 {{ v.meta.transcript_lang }} ·
  vision={{ 'on' if v.analysis.vision_used else 'off' }}
  {% if v.segments.vision_reason %}（{{ v.segments.vision_reason }}）{% endif %} ·
  <a href="{{ v.meta.url }}" target="_blank" rel="noopener">YouTube</a>
</p>
{% if v.estimate or v.timings %}
<table><tr><th>階段</th><th>預估</th><th>實際</th></tr>
{% for st in ['fetch','segment','shot','analyze','render'] %}
<tr><td>{{ st }}</td>
  <td>{{ v.estimate.stages[st].sec|dur if v.estimate and st in v.estimate.stages else '–' }}</td>
  <td>{{ v.timings[st].sec|dur if st in v.timings else '–' }}</td></tr>
{% endfor %}</table>
{% endif %}
<p>{{ v.analysis.author_reasoning }}</p>
<div class="mm-wrap" data-cap="推理鏈 · {{ v.meta.title }}"><pre class="mermaid">
{{ v.chain_mermaid }}
</pre></div>
<details class="desc"><summary>推理鏈的文字說明</summary><div>
  <p class="muted">每個節點是一段，箭頭上的字是該段留給下一段的線索。hover 節點看該段摘要、hover 箭頭文字看完整線索。</p>
  <ol>{% for c in v.chain_desc %}<li><a href="#{{ v.id }}-s{{ c.id }}">{{ c.title }}</a>{% if not loop.last %} → <i>{{ c.leads_to }}</i>{% endif %}</li>{% endfor %}</ol>
</div></details>
{% endfor %}

<!-- 3 -->
<h2>3. 逐段說明</h2>
{% for v in videos %}
<h3>{{ v.meta.title }}</h3>
{% for s in v.analysis.segments %}
<section class="seg" id="{{ v.id }}-s{{ s.id }}">
  <h4>{{ s.id }}. {{ s.title }} <span class="muted"><a href="{{ v.meta.url }}&t={{ s.start|int }}s" target="_blank" rel="noopener">{{ s.start|ts }}</a>–{{ s.end|ts }}</span></h4>
  {% if s.summary %}<p><i>作者說：</i>{{ s.summary }}</p>{% endif %}
  {% if s.shots %}
  <div class="frames">
    {% for sh in s.shots %}<figure><img src="{{ sh.href }}" alt="{{ sh.why }}" loading="lazy" data-video="{{ v.id }}" data-idx="{{ sh.idx }}"><figcaption>{{ sh.t|ts }} · {{ sh.why }}</figcaption></figure>{% endfor %}
  </div>
  {% endif %}
  <div class="bridge"><b>承上</b> {{ s.builds_on }}</div>
  <p><span class="tag r">推理</span>{{ s.reasoning }}</p>
  {% if s.explanation %}<p><span class="tag ai">AI 補充</span>{{ s.explanation }}</p>{% endif %}
  {% if s.terms %}
  <dl class="terms">
    {% for t in s.terms %}
    {% set tid = v.id ~ '-' ~ s.id ~ '-' ~ loop.index %}
    <dt><span class="term" data-zh="{{ t.zh }}">{{ t.term }}</span><button class="info" data-term="{{ tid }}" title="更多說明" aria-label="更多說明">i</button></dt>
    <dd>{{ t.definition }}{% if t.related %} <span class="muted">相關：{% for r in t.related %}{{ r.term if r is mapping else r }}{% if not loop.last %}、{% endif %}{% endfor %}</span>{% endif %}</dd>
    <dialog id="term-{{ tid }}">
      <button class="close" data-close aria-label="關閉">✕</button>
      <h3>{{ t.term }}</h3>
      <div class="zh">{{ t.zh }}</div>
      <p>{{ t.definition }}</p>
      {% if t.more %}<p>{{ t.more }}</p>{% endif %}
      {% if t.related %}<p class="muted">相關術語：{% for r in t.related %}{{ r.term if r is mapping else r }}{% if r is mapping and r.rel %}（{{ r.rel }}）{% endif %}{% if not loop.last %}、{% endif %}{% endfor %}</p>{% endif %}
      <p class="muted">出處：第 {{ s.id }} 段「{{ s.title }}」</p>
    </dialog>
    {% endfor %}
  </dl>
  {% endif %}
  {% if s.issues %}
  <div class="issues">
    {% for iss in s.issues %}
    <div class="issue {{ iss.level }}">
      <span class="lvl">{{ '確定錯誤／已過時' if iss.level == 'wrong' else '見仁見智' }}</span>
      <a href="{{ v.meta.url }}&t={{ iss.t|int }}s" target="_blank" rel="noopener" class="muted">{{ iss.t|ts }}</a>
      <blockquote>「{{ iss.quote }}」</blockquote>
      <div>{{ iss.note }}</div>
      {% if iss.evidence %}<div class="ev">依據：{{ iss.evidence }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="bridge"><b>留給下一段</b> {{ s.leads_to }}</div>
</section>
{% endfor %}
{% endfor %}

<!-- 4 -->
<h2>4. 總結</h2>
<p>{{ overview.summary }}</p>
{% set all_issues = videos | map(attribute='issues') | sum(start=[]) %}
{% if all_issues %}
<h4>勘誤總整理</h4>
<p class="legend-issues muted"><span><i style="background:var(--wrong)"></i>確定錯誤／已過時</span><span><i style="background:var(--debat)"></i>見仁見智（取決於版本或情境）</span></p>
<div style="overflow-x:auto"><table class="issues-sum">
<tr><th>段落</th><th>原話（transcript 逐字）</th><th>說明</th></tr>
{% for v in videos %}{% for iss in v.issues %}
<tr class="{{ iss.level }}"><td><a href="#{{ v.id }}-s{{ iss.seg_id }}">{{ iss.seg_id }}. {{ iss.seg_title }}</a><br><span class="muted">{{ iss.t|ts }}</span></td>
<td class="q">「{{ iss.quote }}」</td><td>{{ iss.note }}{% if iss.evidence %}<br><span class="ev">依據：{{ iss.evidence }}</span>{% endif %}</td></tr>
{% endfor %}{% endfor %}
</table></div>
{% endif %}
<div class="mm-wrap" data-cap="Mindmap"><pre class="mermaid">
{{ mindmap }}
</pre></div>
<details class="desc"><summary>Mindmap 的文字說明</summary><div>
  <p class="muted">根 = 主題；第二層 = 影片；第三層 = 段落；第四層 = 該段首次定義的術語。</p>
  <ul><li><b>{{ overview.topic }}</b>
    <ul>{% for v in videos %}<li>{{ v.meta.title }}
      <ul>{% for s in v.analysis.segments %}<li><a href="#{{ v.id }}-s{{ s.id }}">{{ s.id }}. {{ s.title }}</a>{% if s.terms %} — {{ s.terms|map(attribute='term')|join('、') }}{% endif %}</li>{% endfor %}</ul>
    </li>{% endfor %}</ul>
  </li></ul>
</div></details>
{% if term_graph %}
<h4>術語關聯圖</h4>
<p class="legend">{% for g in term_legend %}<span><i style="background:{{ g.color }}"></i>{{ g.title }}</span>{% endfor %}</p>
<div class="mm-wrap" data-cap="術語關聯圖"><pre class="mermaid">
{{ term_graph }}
</pre></div>
<details class="desc"><summary>術語關聯圖的文字說明</summary><div>
  <p class="muted">節點顏色 = 首次定義的段落（見上方圖例）；箭頭 A → B 表示 A 的定義牽涉 B，線上文字是關係；雙箭頭且標籤前有 ⇄ = 兩者定義互相引用。hover 節點看定義、hover 線上文字看完整關係。</p>
  <ul>{% for e in term_edges %}<li><b>{{ e.a }}</b> {{ '⇄' if e.both else '→' }} <b>{{ e.b }}</b>{% if e.rel %}：{{ e.a }} → {{ e.b }} {{ e.rel }}{% endif %}{% if e.both and e.rel_back %}；{{ e.b }} → {{ e.a }} {{ e.rel_back }}{% endif %}</li>{% endfor %}</ul>
</div></details>
{% endif %}

<!-- 5 -->
<h2>5. 推薦三個下一步</h2>
{% for n in overview.next_steps %}
<div class="card">
  <h4>{{ loop.index }}. {{ n.direction }}</h4>
  <p>{{ n.why }}</p>
  <p>YouTube 搜尋：{% for k in n.search_keywords %}<a href="{{ k|yt_search }}" target="_blank" rel="noopener"><code>{{ k }}</code></a>{{ ' ' }}{% endfor %}</p>
</div>
{% endfor %}

</main>

{% endblock %}
{% block json %}
<script id="shots-data" type="application/json">{{ videos | map(attribute='all_shots') | list | tojson }}</script>
<script id="shots-ids" type="application/json">{{ videos | map(attribute='id') | list | tojson }}</script>
{% endblock %}
{% block js %}
  /* 截圖 → lightbox：輪流同一支影片的所有截圖 */
  const shotsByVideo = JSON.parse(document.getElementById("shots-data").textContent);
  const videoIds = JSON.parse(document.getElementById("shots-ids").textContent);
  const fmtTs = (s) => { s = Math.floor(s); const m = Math.floor(s / 60), r = s % 60; return `${m}:${String(r).padStart(2, "0")}`; };
  document.querySelectorAll(".frames img").forEach((img) => {
    img.addEventListener("click", () => {
      const shots = shotsByVideo[videoIds.indexOf(img.dataset.video)];
      open(shots.map((sh) => ({ type: "img", src: sh.href, caption: `${sh.seg_title} · ${fmtTs(sh.t)} · ${sh.why}` })), +img.dataset.idx);
    });
  });

  /* 術語 ⓘ → dialog */
  document.querySelectorAll(".info[data-term]").forEach((b) => {
    b.addEventListener("click", () => document.getElementById("term-" + b.dataset.term).showModal());
  });
  document.querySelectorAll("dialog").forEach((d) => {
    d.querySelector("[data-close]").addEventListener("click", () => d.close());
    d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
  });
{% endblock %}
