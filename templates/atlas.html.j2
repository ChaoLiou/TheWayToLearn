{% extends "_base.html.j2" %}
{% import "_icons.html.j2" as ic %}
{% import "_search.html.j2" as search %}
{% block title %}{{ S.atlas_title }}{% endblock %}
{% block css %}
  main { max-width: 1180px; }
  .topnav { display:flex; gap:.4rem 1rem; flex-wrap:wrap; font-size:.9rem; margin:-.6rem 0 1rem; }
  .topnav a { text-decoration:none; color:var(--muted); } .topnav a.on { color:var(--fg); font-weight:700; }
  .stats { display:flex; gap:1.5rem; flex-wrap:wrap; color:var(--muted); font-size:.9rem; }
  {{ search.css() }}
  /* ---- 各站：YouTube 式縮圖卡 ---- */
  .region { margin:2rem 0; padding:1rem 1.2rem; border:2px dashed var(--line); border-radius:12px; }
  .region h3 { margin:0 0 .2rem; display:flex; align-items:center; gap:.5rem; }
  .region h3 i { display:inline-block; width:.9rem; height:.9rem; border-radius:3px; }
  .region .blurb { color:var(--muted); margin:0 0 .8rem; }
  .wps { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:1.4rem 1rem; }
  .wp { display:flex; flex-direction:column; gap:.45rem; min-width:0; }
  .wp[hidden] { display:none; }
  .wp .thumb { position:relative; display:block; aspect-ratio:16/9; border-radius:10px; overflow:hidden;
               background:var(--card); border:1px solid var(--line); }
  .wp .thumb img { position:relative; width:100%; height:100%; object-fit:cover; display:block; }
  /* 沒縮圖／圖抓不到：用標題第一個字當縮圖，不留破圖 */
  /* 沒縮圖：放完整標題，超過四行就截斷加「…」，永遠不溢出 */
  .wp .thumb .ph { position:absolute; inset:0; display:grid; place-items:center; padding:.6rem .8rem; color:var(--muted);
                   font-size:.95rem; font-weight:700; line-height:1.3; text-align:center; overflow:hidden; overflow-wrap:anywhere;
                   background:linear-gradient(135deg, var(--card), var(--line)); user-select:none; }
  .wp .thumb .ph > span { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:4; overflow:hidden; }
  .wp .dur { position:absolute; right:.35rem; bottom:.35rem; background:rgba(0,0,0,.8); color:#fff;
             font-size:.75rem; font-weight:600; padding:.05rem .3rem; border-radius:4px; }
  .wp h4 { margin:0; font-size:.98rem; line-height:1.35; color:var(--fg);
           display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .wp h4 a { color:inherit; text-decoration:none; }
  .wp h4 a:hover { color:var(--accent); }
  .wp .by { font-size:.88rem; color:var(--muted); }
  /* 這支影片的勘誤件數：紅 = 確定錯誤／已過時，橘 = 見仁見智；點開看整張表 */
  .err { display:inline-flex; align-items:center; gap:.2rem; margin-left:.35rem; font-size:.74rem; font-weight:600;
         line-height:1.5; white-space:nowrap; padding:0 .35rem; border-radius:999px; border:1px solid var(--line);
         font-family:inherit; background:none; }
  button.err { cursor:pointer; }
  button.err:hover { filter:brightness(1.15); }
  .err svg { width:.85em; height:.85em; }
  .err.w { color:var(--wrong); border-color:var(--wrong); background:var(--wrong-bg); }
  .err.d { color:var(--debat); border-color:var(--debat); background:var(--debat-bg); }
  .err.ok { color:var(--muted); font-weight:400; }
  .err-legend { font-size:.8rem; color:var(--muted); margin:.3rem .2rem 0; display:flex; align-items:center;
                gap:.3rem; flex-wrap:wrap; }
  .err-legend svg { width:.9rem; height:.9rem; vertical-align:-.15em; }
  .err-legend .w { color:var(--wrong); } .err-legend .d { color:var(--debat); }
  .wp .wp-err { display:none; }
  .err-legend span { display:inline-flex; align-items:center; gap:.25rem; margin-right:.6rem; }
  .wp .sub { font-size:.82rem; color:var(--muted); }
  .wp .cat { display:inline-flex; align-items:center; gap:.3rem; font-size:.78rem; color:var(--muted); }
  .wp .cat i { display:inline-block; width:.55rem; height:.55rem; border-radius:2px; }
  .wp .more-btn { align-self:flex-start; background:none; border:1px solid var(--line); border-radius:999px;
                  color:var(--muted); font:inherit; font-size:.78rem; padding:.05rem .55rem; cursor:pointer; }
  .wp .more-btn:hover { border-color:var(--accent); color:var(--accent); }
  .wp .wp-info { display:none; }
  /* 進度：十步各一格 */
  .wp .prog { display:flex; gap:3px; margin:.1rem 0 0; }
  .wp .prog span { flex:1; height:5px; border-radius:3px; background:var(--line); }
  .wp .prog span[data-s="done"] { background:var(--accent); }
  .wp .prog span[data-s="partial"] { background:linear-gradient(90deg, var(--accent) 55%, var(--line) 55%); }
  .wp .prog span[data-s="running"] { background:var(--accent); opacity:.5; animation:pulse 1.4s ease-in-out infinite; }
  .wp .prog span[data-s="skip"] { background:none; border:1px dashed var(--line); height:3px; align-self:center; }
  @keyframes pulse { 50% { opacity:1; } }
  .wp .stg { font-size:.78rem; color:var(--muted); display:flex; align-items:center; gap:.35rem; flex-wrap:wrap; }
  .wp .stg b { color:var(--fg); font-weight:600; }
  .wp .stg .warn { color:var(--accent); }
  .wp .acts { display:flex; gap:.4rem; flex-wrap:wrap; }
  .wp .go { background:var(--accent); color:#fff; border:none; border-radius:999px;
            font:inherit; font-size:.78rem; padding:.1rem .7rem; cursor:pointer; }
  .wp .go.done { background:none; border:1px solid var(--line); color:var(--muted); }
  .wp .go:hover { filter:brightness(1.1); }
  /* 繼續做：選一個目標 → 複製 prompt */
  /* 置中視窗（繼續做／詳細／勘誤）共用同一套外框、標題列與內文 */
  dialog.modal { border:1px solid var(--line); border-radius:12px; background:var(--bg); color:var(--fg);
                 width:min(560px, 92vw); max-height:86vh; padding:0; overflow:hidden; }
  dialog.modal::backdrop { background:var(--overlay); }
  dialog.modal .head { display:flex; align-items:flex-start; gap:.6rem; padding:.9rem 1.1rem .6rem; border-bottom:1px solid var(--line); }
  dialog.modal .head h3 { margin:0; font-size:1.03rem; line-height:1.4; flex:1; }
  dialog.modal .head .by { display:block; font-size:.85rem; color:var(--muted); font-weight:400; margin-top:.2rem; }
  dialog.modal .head button { background:none; border:none; color:var(--muted); font-size:1.3rem; line-height:1; cursor:pointer; padding:0 .2rem; }
  dialog.modal .body { padding:.9rem 1.1rem 1.1rem; overflow:auto; max-height:calc(86vh - 4.6rem); font-size:.93rem; }
  dialog.modal .body ul { margin:.3rem 0; padding-left:1.2rem; }
  /* 繼續做：選一個目標 → 複製 prompt */
  #nextstep { width:min(640px, 94vw); }
  #nextstep ol.steps { list-style:none; margin:.2rem 0 1rem; padding:0; display:grid; gap:.15rem; }
  #nextstep ol.steps li { display:flex; align-items:center; gap:.5rem; font-size:.9rem; color:var(--muted); }
  #nextstep ol.steps li .m { width:1.2rem; text-align:center; }
  #nextstep ol.steps li.done { color:var(--fg); }
  #nextstep ol.steps li.partial .m, #nextstep ol.steps li.running .m { color:var(--accent); }
  #nextstep ol.steps li .note { font-size:.82rem; color:var(--accent); }
  #nextstep h4 { margin:.6rem 0 .1rem; font-size:.95rem; }
  #nextstep .hint { font-size:.82rem; color:var(--muted); margin:0 0 .5rem; }
  #nextstep .opts { display:grid; gap:.4rem; }
  #nextstep .opts button { text-align:left; background:var(--card); border:1px solid var(--line); border-radius:8px;
                           padding:.45rem .7rem; cursor:pointer; font:inherit; color:var(--fg); }
  #nextstep .opts button:hover, #nextstep .opts button.on { border-color:var(--accent); }
  #nextstep .opts button span { display:block; font-size:.8rem; color:var(--muted); }
  #nextstep .out[hidden] { display:none; }
  #nextstep .out { margin-top:.8rem; }
  #nextstep pre { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:.6rem .7rem;
                  white-space:pre-wrap; word-break:break-word; font-size:.82rem; max-height:32vh; overflow:auto; margin:.3rem 0; }
  #nextstep .copy { background:var(--accent); color:#fff; border:none; border-radius:6px;
                    padding:.3rem .8rem; cursor:pointer; font:inherit; }
  .wp .terms { font-size:.78rem; color:var(--muted); }
  /* 詳細 */
  #wpinfo .body .shot { display:block; margin:0 0 .7rem; border-radius:10px; overflow:hidden; border:1px solid var(--line); }
  #wpinfo .body .shot img { display:block; width:100%; aspect-ratio:16/9; object-fit:cover; }
  /* 勘誤：表格寬一點 */
  #errinfo { width:min(760px, 94vw); }
  .routes { font-size:.85rem; margin-top:.3rem; }
  .routes .rt { display:inline-block; font-size:.7rem; font-weight:700; padding:0 .4rem; border-radius:999px; background:var(--accent); color:#fff; margin-right:.3rem; }
  .routes .via { color:var(--muted); }
{% endblock %}
{% block body %}
<main>
{% if has_listen or has_notes %}
<p class="topnav">{% if has_listen %}<a href="listen.html">{{ S.nav_listen }}</a>{% endif %}{% if has_notes %}<a href="notes.html">{{ S.nav_notes }}</a>{% endif %}{% if has_digest %}<a href="digest.html">{{ S.nav_digest }}</a>{% endif %}<a class="on" href="atlas.html">{{ S.nav_atlas }}</a></p>
{% endif %}
<h1>{{ S.atlas_h1 }}</h1>
<p class="stats"><span>{{ S.f("n_wp", n=waypoints|length) }}</span><span>{{ S.f("n_region", n=regions|length) }}</span><span id="updated" data-ts="{{ generated_iso }}" title="{{ generated }}">{{ S.f("updated", t=generated) }}</span></p>


<h2>{{ S.h_stations }}</h2>
<p class="err-legend">{{ S.err_legend }}<span class="w">{{ ic.danger() }}{{ S.lvl_wrong }}</span><span class="d">{{ ic.warn() }}{{ S.lvl_debatable }}</span></p>
{{ search.bar(S, waypoints|length) }}

{% macro card(w, color, cat) %}
<article class="wp" data-id="{{ w.id }}" data-title="{{ w.title }}" data-channel="{{ w.channel or '' }}" data-category="{{ cat }}">
  <a class="thumb" href="{{ w.href }}">
    <span class="ph" aria-hidden="true"><span>{{ w.title }}</span></span>
    {% if w.yt_thumb or w.thumb %}<img loading="lazy" src="{{ w.yt_thumb or w.thumb }}" data-fallback="{{ w.thumb if w.yt_thumb and w.thumb else '' }}" alt="{{ w.title }}">{% endif %}
    <span class="dur">{{ w.duration|dur }}</span>
  </a>
  <h4><a href="{{ w.href }}">{{ w.title }}</a></h4>
  <div class="by">{{ w.channel }}{% if w.err %}{% if w.err.clean %}<span class="err ok" title="{{ w.err.tip }}">{{ S.err_ok }}</span>{% else %}{% if w.err.wrong %}<button class="err w" type="button" data-err title="{{ w.err.tip }}">{{ ic.danger() }}{{ w.err.wrong }}</button>{% endif %}{% if w.err.debatable %}<button class="err d" type="button" data-err title="{{ w.err.tip }}">{{ ic.warn() }}{{ w.err.debatable }}</button>{% endif %}{% endif %}{% endif %}</div>
  <div class="sub">{% if w.upload_date %}<span title="{{ w.upload_date }}">{{ w.upload_days|ago }}</span> · {% endif %}{{ S.f("n_seg", n=w.n_segments) }} · <a href="{{ w.url }}" target="_blank" rel="noopener">{{ S.blog_link if w.kind == 'blog' else 'YouTube' }}</a></div>
  <div class="cat"><i style="background:{{ color }}"></i>{{ cat }}</div>
  <div class="prog" title="{{ S.progress }} {{ w.n_done }}/{{ w.n_total }}">
    {% for st in w.stages %}<span data-s="{{ st.state }}" title="{{ st.n }}. {{ st.name }} · {{ S['st_' + st.state] }}{% if st.note %} — {{ st.note }}{% endif %}"></span>{% endfor %}
  </div>
  <div class="stg"><b>{{ w.n_done }}/{{ w.n_total }}</b>{% if w.note %}<span class="{{ '' if w.all_done else 'warn' }}">{{ w.note }}</span>{% endif %}</div>
  <div class="acts">
    <button class="more-btn" type="button">{{ S.more_info }}</button>
    <button class="go{{ ' done' if w.all_done }}" type="button">{{ S.next_step }}</button>
  </div>
  <div class="wp-info">
    <div><b>{{ w.topic }}</b></div>
    <ul>{% for t in w.takeaways %}<li>{{ t }}</li>{% endfor %}</ul>
    {% if w.terms %}<div class="terms">{{ S.terms }}{% for t in w.terms[:8] %}<code>{{ t }}</code>{{ ' ' }}{% endfor %}{% if w.terms|length > 8 %}{{ S.f("terms_total", n=w.terms|length) }}{% endif %}</div>{% endif %}
    {% if w.routes_in or w.routes_out %}
    <div class="routes">
      {% for e in w.routes_in %}<div><span class="rt">{{ S.route(e.type) }} {{ '—' if e.type != 'next' else '←' }}</span><a href="{{ e.other.href }}">{{ e.other.title }}</a> <span class="via">· {{ e.via }}</span></div>{% endfor %}
      {% for e in w.routes_out %}<div><span class="rt">{{ S.route(e.type) }} {{ '—' if e.type != 'next' else '→' }}</span><a href="{{ e.other.href }}">{{ e.other.title }}</a> <span class="via">· {{ e.via }}</span></div>{% endfor %}
    </div>
    {% endif %}
    <div><a href="{{ w.href }}">{{ S.open_plan }}</a></div>
  </div>
  {% if w.issues %}
  <div class="wp-err">
    <p class="err-legend"><span class="w">{{ ic.danger() }}{{ S.lvl_wrong }}</span><span class="d">{{ ic.warn() }}{{ S.lvl_debatable_long }}</span></p>
    <div style="overflow-x:auto"><table class="issues-sum">
      <tr><th>{{ S.col_seg }}</th><th>{{ S.col_quote }}</th><th>{{ S.col_note }}</th></tr>
      {% for iss in w.issues %}
      <tr class="{{ iss.level }}">
        <td><span class="lv">{{ ic.level(iss.level) }}</span><a href="{{ w.href }}#{{ w.id }}-s{{ iss.seg_id }}">{{ iss.seg_id }}. {{ iss.seg_title }}</a><br><span class="muted">{{ iss.t|ts }}</span></td>
        <td class="q">「{{ iss.quote }}」</td>
        <td>{{ iss.note }}{% if iss.evidence %}<br><span class="ev">{{ S.evidence }}: {{ iss.evidence }}</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table></div>
  </div>
  {% endif %}
</article>
{% endmacro %}
{% for r in regions %}
<section class="region" style="border-color:{{ r.color }}">
  <h3><i style="background:{{ r.color }}"></i>{{ r.name }}</h3>
  <p class="blurb">{{ r.blurb }}</p>
  <div class="wps">{% for w in r.members %}{{ card(w, r.color, r.name) }}{% endfor %}</div>
</section>
{% endfor %}
{% if unplaced %}
<section class="region">
  <h3><i style="background:var(--muted)"></i>{{ S.unplaced }}</h3>
  <p class="blurb">{{ S.unplaced_desc }}{% if waypoints|length >= 2 %} {{ S.unplaced_hint | safe }}{% endif %}</p>
  <div class="wps">{% for w in unplaced %}{{ card(w, 'var(--muted)', S.unplaced) }}{% endfor %}</div>
</section>
{% endif %}
<dialog id="nextstep" class="modal">
  <div class="head"><h3></h3><button type="button" data-close aria-label="{{ S.close }}">✕</button></div>
  <div class="body">
    <ol class="steps"></ol>
    <h4>{{ S.next_q }}</h4>
    <p class="hint">{{ S.next_hint }}</p>
    <div class="opts"></div>
    <div class="out" hidden>
      <pre></pre>
      <button class="copy" type="button">{{ S.copy_prompt }}</button>
    </div>
  </div>
</dialog>
<dialog id="wpinfo" class="modal">
  <div class="head"><h3></h3><button type="button" data-close aria-label="{{ S.close }}">✕</button></div>
  <div class="body"></div>
</dialog>
<dialog id="errinfo" class="modal">
  <div class="head"><h3></h3><button type="button" data-close aria-label="{{ S.close }}">✕</button></div>
  <div class="body"></div>
</dialog>
</main>
{% endblock %}
{% block json %}
<script id="steps-data" type="application/json">{{ steps_data | tojson }}</script>
{{ search.json(S) }}
{% endblock %}
{% block js %}

  /* 「更新於」在瀏覽當下算相對時間，隔天再打開也不會停在產生時的那一刻 */
  const AGO = {{ {"now": S.ago_now, "today": S.ago_today, "h": S.ago_h, "d": S.ago_d,
                  "mo": S.ago_mo, "y": S.ago_y, "updated": S.updated} | tojson }};
  (() => {
    const el = document.getElementById("updated"), t = Date.parse(el.dataset.ts);
    if (!t) return;
    const h = Math.floor((Date.now() - t) / 36e5), d = Math.floor(h / 24);
    const f = (k, n) => AGO[k].replace("{n}", n);
    const rel = h < 1 ? AGO.now : h < 24 ? f("h", h)
      : d < 30 ? f("d", d) : d < 365 ? f("mo", Math.max(1, Math.floor(d / 30))) : f("y", Math.floor(d / 365));
    el.textContent = AGO.updated.replace("{t}", rel);
  })();

  /* 縮圖抓不到（沒截圖或離線）就換另一個來源 */
  document.querySelectorAll(".wp .thumb img").forEach((img) => {
    img.addEventListener("error", () => {
      const fb = img.dataset.fallback;
      if (fb) { img.dataset.fallback = ""; img.src = fb; }
      else { img.remove(); }
    });
  });

  /* 繼續做：看這一站走到哪，選一個目標，複製 prompt 貼到 Claude Code */
  const STEPS = JSON.parse(document.getElementById("steps-data").textContent);
  const NS = document.getElementById("nextstep");
  const NSTR = {{ {"copy": S.copy_prompt, "copied": S.copied, "done": S.st_done, "todo": S.st_todo,
                   "partial": S.st_partial, "skip": S.st_skip, "running": S.st_running} | tojson }};
  const MARK = { done: "✔", partial: "◐", todo: "○", skip: "·", running: "◔" };
  const copyText = async (text, btn) => {
    try { await navigator.clipboard.writeText(text); }
    catch (_) {                                   // file:// 開啟時 clipboard API 會被擋，用舊招
      const ta = document.createElement("textarea");
      ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); } catch (__) {}
      ta.remove();
    }
    btn.textContent = NSTR.copied;
    setTimeout(() => { btn.textContent = NSTR.copy; }, 1600);
  };
  document.querySelectorAll(".wp .go").forEach((btn) => {
    btn.addEventListener("click", () => {
      const d = STEPS[btn.closest(".wp").dataset.id];
      if (!d) return;
      NS.querySelector(".head h3").textContent = d.title;
      NS.querySelector("ol.steps").replaceChildren(...d.stages.map((st) => {
        const li = document.createElement("li");
        li.className = st.state;
        li.append(Object.assign(document.createElement("span"), { className: "m", textContent: MARK[st.state] }));
        li.append(`${st.n}. ${st.name}`);
        const tail = st.note || (st.state === "done" ? "" : NSTR[st.state]);
        if (tail) li.append(Object.assign(document.createElement("span"), { className: "note", textContent: "— " + tail }));
        return li;
      }));
      const out = NS.querySelector(".out"), pre = NS.querySelector(".out pre");
      out.hidden = true;
      NS.querySelector(".opts").replaceChildren(...d.actions.map((a) => {
        const b = document.createElement("button");
        b.type = "button";
        b.append(a.label, Object.assign(document.createElement("span"), { textContent: a.desc }));
        b.addEventListener("click", () => {
          NS.querySelectorAll(".opts button").forEach((x) => x.classList.remove("on"));
          b.classList.add("on");
          pre.textContent = a.prompt;
          out.hidden = false;
          copyText(a.prompt, NS.querySelector(".copy"));
          out.scrollIntoView({ block: "nearest", behavior: "smooth" });
        });
        return b;
      }));
      NS.showModal();
    });
  });
  NS.querySelector(".copy").addEventListener("click", (e) => copyText(NS.querySelector(".out pre").textContent, e.currentTarget));
  NS.querySelector("[data-close]").addEventListener("click", () => NS.close());
  NS.addEventListener("click", (e) => { if (e.target === NS) NS.close(); });

  /* 詳細 → 置中視窗 */
  const DLG = document.getElementById("wpinfo");
  function showInfo(wp) {
    const h3 = DLG.querySelector(".head h3");
    h3.innerHTML = "";
    h3.append(wp.dataset.title,
      Object.assign(document.createElement("span"), { className: "by", textContent: wp.dataset.channel }));
    const shot = wp.querySelector(".thumb img");
    const body = [];
    if (shot) {                                  // 節點上看到的縮圖，視窗裡放大一點
      const fig = document.createElement("a");
      fig.className = "shot";
      fig.href = wp.querySelector("h4 a").getAttribute("href");
      fig.append(Object.assign(document.createElement("img"), { src: shot.currentSrc || shot.src, alt: "" }));
      body.push(fig);
    }
    body.push(...[...wp.querySelector(".wp-info").children].map((n) => n.cloneNode(true)));
    DLG.querySelector(".body").replaceChildren(...body);
    DLG.showModal();
  }
  document.querySelectorAll(".wp .more-btn").forEach((btn) => {
    btn.addEventListener("click", () => showInfo(btn.closest(".wp")));
  });
  DLG.addEventListener("click", (e) => { if (e.target === DLG || e.target.closest("[data-close]")) DLG.close(); });

  /* 勘誤膠囊 → 這支影片的勘誤表（同樣是置中視窗） */
  const EDLG = document.getElementById("errinfo");
  document.querySelectorAll(".wp button.err[data-err]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const wp = btn.closest(".wp"), tbl = wp.querySelector(".wp-err");
      if (!tbl) return;
      const h3 = EDLG.querySelector("h3");
      h3.innerHTML = "";
      h3.append({{ S.err_title | tojson }} + " · " + wp.dataset.title,
        Object.assign(document.createElement("span"), { className: "by", textContent: wp.dataset.channel }));
      EDLG.querySelector(".body").replaceChildren(...[...tbl.children].map((n) => n.cloneNode(true)));
      EDLG.showModal();
    });
  });
  EDLG.addEventListener("click", (e) => { if (e.target === EDLG || e.target.closest("[data-close]")) EDLG.close(); });

{{ search.js(".wp", "section.region") }}
{% endblock %}
