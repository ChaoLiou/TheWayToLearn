{% extends "_lite.html.j2" %}
{% import "_search.html.j2" as search %}
{% block title %}{{ S.listen_title }}{% endblock %}
{% block css %}
  main { padding-bottom: 12rem; }   /* 留給置底播放器 */
  {{ search.css() }}
  .ep .cat { color:var(--accent); cursor:pointer; } .ep .cat:hover { text-decoration:underline; }
  .ep[hidden] { display:none; }
  /* ---- 集數列表 ---- */
  .ep { display:grid; grid-template-columns: 7.5rem 1fr; gap:.9rem; align-items:start;
        padding:.8rem 0; border-bottom:1px solid var(--line); }
  .ep .cov { position:relative; width:7.5rem; aspect-ratio:16/9; border-radius:8px; overflow:hidden; background:var(--card); cursor:pointer; }
  .ep .cov img { position:relative; width:100%; height:100%; object-fit:cover; display:block; }
  /* 沒縮圖／圖抓不到：用標題第一個字當縮圖，不留破圖 */
  .ph { position:absolute; inset:0; display:grid; place-items:center; font-weight:700; color:var(--muted);
        background:linear-gradient(135deg, var(--card), var(--line)); user-select:none; }
  /* 卡片：放完整標題，超過三行就截斷加「…」，永遠不溢出 */
  .ep .cov .ph { padding:.3rem .4rem; font-size:.72rem; line-height:1.25; text-align:center; overflow:hidden; overflow-wrap:anywhere; }
  .ep .cov .ph > span { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; }
  .ep .cov .pl { position:absolute; inset:0; display:grid; place-items:center; color:#fff; font-size:1.8rem;
                 background:rgba(0,0,0,.25); opacity:0; transition:opacity .15s; text-shadow:0 1px 6px rgba(0,0,0,.6); }
  .ep .cov:hover .pl, .ep.playing .cov .pl { opacity:1; }
  .ep .cov .dur { position:absolute; right:.3rem; bottom:.3rem; background:rgba(0,0,0,.75); color:#fff;
                  font-size:.72rem; padding:0 .3rem; border-radius:3px; }
  .ep .cov .bar { position:absolute; left:0; bottom:0; height:3px; background:var(--accent); width:0; }
  .ep h3 { margin:0 0 .15rem; font-size:1.02rem; line-height:1.35; }
  .ep h3 a { color:var(--fg); text-decoration:none; } .ep h3 a:hover { color:var(--accent); }
  .ep.playing h3 { color:var(--accent); }
  .ep .meta { font-size:.82rem; color:var(--muted); display:flex; flex-wrap:wrap; gap:.2rem .7rem; }
  .ep .acts { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.45rem; }
  .ep .acts a, .ep .acts button { font:inherit; font-size:.82rem; padding:.18rem .6rem; border-radius:999px; text-decoration:none;
        border:1px solid var(--line); background:var(--card); color:var(--fg); cursor:pointer; }
  .ep .acts a:hover, .ep .acts button:hover { border-color:var(--accent); color:var(--accent); }
  .ep .acts button.play { background:var(--accent); color:#fff; border-color:var(--accent); }
  .tag { display:inline-block; font-size:.7rem; font-weight:700; padding:0 .4rem; border-radius:4px; background:var(--accent); color:#fff; }
  .tag.done { background:var(--ok); } .tag.res { background:var(--muted); }
  @media (max-width:520px) { .ep { grid-template-columns: 5.6rem 1fr; gap:.6rem; } .ep .cov { width:5.6rem; } }
  /* ---- 置底播放器 ---- */
  #bar { position:fixed; left:0; right:0; bottom:0; z-index:90; background:var(--bg); border-top:1px solid var(--line);
         box-shadow:0 -6px 24px rgba(0,0,0,.18); padding:.5rem max(1rem, env(safe-area-inset-left)) max(.5rem, env(safe-area-inset-bottom)); }
  #bar[hidden] { display:none; }
  #bar .in { max-width:820px; margin:0 auto; display:grid; grid-template-columns: 3.6rem 1fr; gap:.3rem .8rem; align-items:center; }
  #bar .bimg { position:relative; width:3.6rem; aspect-ratio:16/9; border-radius:6px; overflow:hidden; grid-row:span 2; background:var(--card); }
  #bar .bimg img { position:relative; width:100%; height:100%; object-fit:cover; display:block; }
  #bar .bimg img[hidden] { display:none; }  /* display:block 會蓋掉 hidden，破圖就露出來了 */
  #bar .bimg .ph { padding:.15rem .2rem; font-size:.5rem; line-height:1.2; text-align:center; overflow:hidden; overflow-wrap:anywhere; }
  #bar .bimg .ph > span { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; }
  #bar .ttl { font-size:.92rem; font-weight:600; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  #bar .ttl a { color:var(--fg); text-decoration:none; } #bar .ttl a:hover { color:var(--accent); }
  #bar .ttl .np { font-size:.72rem; color:var(--muted); font-weight:400; margin-right:.4rem; }
  #bar .ttl #b-src { font-size:.8rem; margin-left:.3rem; } #bar .ttl #b-src[hidden] { display:none; }
  #bar .ctl { display:flex; align-items:center; gap:.25rem; flex-wrap:wrap; }
  #bar button, #bar select { font:inherit; font-size:.85rem; background:var(--card); border:1px solid var(--line); color:var(--fg);
         border-radius:8px; padding:.22rem .55rem; cursor:pointer; line-height:1.2; }
  #bar button:hover { border-color:var(--accent); color:var(--accent); }
  #bar button.on { background:var(--accent); color:#fff; border-color:var(--accent); }
  #bar button.big { font-size:1.15rem; padding:.15rem .8rem; }
  #bar .seek { grid-column:1 / -1; display:flex; align-items:center; gap:.5rem; font-size:.78rem; color:var(--muted); }
  #bar .seek input { flex:1; accent-color:var(--accent); }
  #bar .sp { flex:1; }
  /* ---- 字幕：疊在播放器上方，只顯示目前句 ± 2 句 ---- */
  #cc { position:fixed; left:0; right:0; z-index:89; background:var(--bg); border-top:1px solid var(--line); padding:.4rem 1rem .5rem; }
  #cc[hidden] { display:none; }
  #cc .in { max-width:820px; margin:0 auto; }
  #cc .seg { font-size:.72rem; color:var(--accent); margin:0 0 .15rem .4rem; }
  #cc p { margin:0; padding:.08rem .4rem; border-radius:6px; cursor:pointer; color:var(--muted); font-size:.85rem; line-height:1.45;
          overflow:hidden; text-overflow:ellipsis; white-space:nowrap; opacity:.7; }
  #cc p:hover { background:var(--card); }
  #cc p.now { color:var(--fg); background:var(--card); border-left:3px solid var(--accent); font-weight:600; font-size:1rem;
              white-space:normal; opacity:1; }
  #cc p.clip, #cc p.dub { font-style:italic; }
  #cc .msg { color:var(--muted); font-size:.9rem; }
{% endblock %}

{% block body %}
<main>
<p class="topnav">
  <a class="on" href="listen.html">{{ S.nav_listen }}</a>
  {% if has_notes %}<a href="notes.html">{{ S.nav_notes }}</a>{% endif %}
  {% if has_digest %}<a href="digest.html">{{ S.nav_digest }}</a>{% endif %}
  {% if has_atlas %}<a href="atlas.html">{{ S.nav_atlas }}</a>{% endif %}
</p>
<h1>{{ S.listen_h1 }}</h1>
<p class="muted">{{ S.listen_sub }}</p>
<p class="stats"><span>{{ S.f("n_episode", n=episodes|length) }}</span><span>{{ S.f("total_len", t=total|dur) }}</span><span>{{ S.f("updated", t=generated) }}</span></p>

{% if not episodes %}
<p class="card">{{ S.no_episodes | safe }}</p>
{% endif %}

{% if episodes %}{{ search.bar(S, episodes|length) }}{% endif %}
<div id="list">
{% for e in episodes %}
<article class="ep" id="ep-{{ e.id }}" data-i="{{ loop.index0 }}" data-id="{{ e.id }}" data-title="{{ e.title }}" data-channel="{{ e.channel or '' }}" data-category="{{ e.category or S.unplaced }}">
  <div class="cov" data-act="play" title="{{ S.play }}">
    <span class="ph" aria-hidden="true"><span>{{ e.title }}</span></span>
    {% if e.yt_thumb or e.thumb %}<img src="{{ e.yt_thumb or e.thumb }}" data-fallback="{{ e.thumb if e.yt_thumb and e.thumb else '' }}" alt="" loading="lazy">{% endif %}
    <span class="pl">▶</span>
    <span class="dur">{{ e.duration|dur }}</span>
    <span class="bar"></span>
  </div>
  <div>
    <h3>{% if e.has_plan %}<a href="{{ e.plan }}">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}</h3>
    <div class="meta">
      {% if e.channel %}<span>{{ e.channel }}</span>{% endif %}
      <span class="cat" data-cat="{{ e.category or S.unplaced }}" title="{{ S.f_category }}">{{ e.category or S.unplaced }}</span>
      <span>{{ S.f("ep_produced", t=e.created_ymd) }}</span>
      {% if e.dub %}<span>{{ S.ep_dub }}</span>{% endif %}
      <span class="st"></span>
    </div>
    <div class="acts">
      <button type="button" class="play" data-act="play">{{ S.play }}</button>
      {% if e.has_plan %}<a href="{{ e.plan }}">{{ S.ep_plan }}</a>{% endif %}
      {% if e.has_notes and has_notes %}<a href="notes.html#{{ e.id }}">{{ S.ep_notes }}</a>{% endif %}
      {% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ "🔗 " ~ (S.blog_link if e.kind == "blog" else S.watch_yt) }}</a>{% endif %}
    </div>
  </div>
</article>
{% endfor %}
</div>
</main>

<div id="cc" hidden><div class="in"><div class="seg"></div><div class="body"></div></div></div>
<div id="bar" hidden>
  <audio id="audio" preload="metadata"></audio>
  <div class="in">
    <div class="bimg"><span class="ph" aria-hidden="true"><span id="b-ph"></span></span><img id="b-img" alt="" hidden></div>
    <div class="ttl"><span class="np">{{ S.p_now_playing }}</span><a id="b-title" href="#"></a> <a id="b-src" href="#" target="_blank" rel="noopener" title="{{ S.watch_yt }}" hidden>🔗</a></div>
    <div class="ctl">
      <button type="button" data-act="prev" title="{{ S.p_prev }}">⏮</button>
      <button type="button" data-act="back" title="{{ S.p_back }}">−15</button>
      <button type="button" class="big" data-act="toggle" title="{{ S.play }}">▶</button>
      <button type="button" data-act="fwd" title="{{ S.p_fwd }}">+15</button>
      <button type="button" data-act="next" title="{{ S.p_next }}">⏭</button>
      <span class="sp"></span>
      <button type="button" id="b-dub" data-act="dub" title="{{ S.dub_hint }}" hidden>{{ S.mode_dub }}</button>
      <button type="button" id="b-cc" data-act="cc" title="{{ S.p_cc }}">CC</button>
      <select id="b-rate" title="{{ S.speed }}">
        {% for r in ["0.8","1","1.15","1.3","1.5","1.75","2"] %}<option value="{{ r }}">{{ r }}×</option>{% endfor %}
      </select>
    </div>
    <div class="seek"><span id="b-cur">0:00</span><input id="b-seek" type="range" min="0" max="1000" value="0"><span id="b-tot">0:00</span></div>
  </div>
</div>
{% endblock %}

{% block json %}
<script id="ep-data" type="application/json">{{ player | tojson }}</script>
{{ search.json(S) }}
<script id="ui-str" type="application/json">{{ {"pause": S.pause, "play": S.play, "loading": S.cc_loading, "missing": S.cc_missing, "resume": S.ep_resume, "done": S.ep_done, "orig": S.mode_orig, "dub": S.mode_dub, "origText": S.orig_text} | tojson }}</script>
{% endblock %}

{% block js %}
(() => {
  const EP = JSON.parse(document.getElementById("ep-data").textContent);

  /* 縮圖抓不到（網址失效或離線）：先換本機截圖，再不行就拿掉，底下的標題首字 .ph 就露出來 */
  document.querySelectorAll(".ep .cov img").forEach((img) => {
    img.addEventListener("error", () => {
      const fb = img.dataset.fallback;
      if (fb) { img.dataset.fallback = ""; img.src = fb; } else { img.remove(); }
    });
  });
  const T = JSON.parse(document.getElementById("ui-str").textContent);
  if (!EP.length) return;
  const $ = (s) => document.querySelector(s);
  const audio = $("#audio"), bar = $("#bar"), cc = $("#cc"), ccBody = $("#cc .body"), ccSeg = $("#cc .seg");
  const ts = (s) => { s = Math.max(0, Math.floor(s || 0)); const m = Math.floor(s / 60); return `${m}:${String(s % 60).padStart(2, "0")}`; };
  const LS = { get: (k) => { try { return localStorage.getItem(k); } catch (_) { return null; } },
               set: (k, v) => { try { localStorage.setItem(k, v); } catch (_) {} },
               del: (k) => { try { localStorage.removeItem(k); } catch (_) {} } };

  let cur = -1, mode = "orig", ccOn = LS.get("listen-cc") === "1";
  let cap = null, lines = [], idx = -1, lastSave = 0;

  /* ---- 列表上的「上次聽到／聽完」 ---- */
  const paintCard = (i) => {
    const e = EP[i], card = document.getElementById("ep-" + e.id);
    if (!card) return;
    const st = card.querySelector(".st"), barEl = card.querySelector(".bar");
    const done = LS.get("listen-done:" + e.id) === "1";
    const pos = parseFloat(LS.get("listen-pos:" + e.id)) || 0;
    st.innerHTML = "";
    if (done) st.innerHTML = `<span class="tag done">${T.done}</span>`;
    else if (pos > 30) st.innerHTML = `<span class="tag res">${T.resume.replace("{t}", ts(pos))}</span>`;
    barEl.style.width = done ? "100%" : (pos > 0 && e.duration ? (100 * pos / e.duration) + "%" : "0");
    card.classList.toggle("playing", i === cur);
  };
  EP.forEach((_, i) => paintCard(i));

  /* ---- 講稿：播到才載入該站的 captions.js ---- */
  const loadCap = (e) => new Promise((res) => {
    window.__cap = window.__cap || {};
    if (window.__cap[e.id]) return res(window.__cap[e.id]);
    const s = document.createElement("script");
    s.src = e.cap; s.onload = () => res(window.__cap[e.id] || null); s.onerror = () => res(null);
    document.head.appendChild(s);
  });
  const CTX = 2;   // 目前句前後各幾句
  const buildScript = () => {
    ccBody.textContent = ""; ccSeg.textContent = ""; lines = []; idx = -1;
    if (!cap) { ccBody.innerHTML = `<p class="msg">${T.missing}</p>`; return; }
    lines = mode === "dub" && cap.d ? cap.d : cap.o;
  };
  const showWindow = (i) => {
    ccBody.textContent = "";
    ccSeg.textContent = lines[i] ? `${lines[i].s}. ${cap.segs[String(lines[i].s)] || ""}` : "";
    for (let j = Math.max(0, i - CTX); j <= Math.min(lines.length - 1, i + CTX); j++) {
      const l = lines[j], p = document.createElement("p");
      p.textContent = (l.l && j === i ? (l.k === "d" ? "🗣 " : "🎙 ") : "") + l.t;
      if (j === i) p.classList.add("now");
      if (l.k === "c") p.classList.add("clip"); if (l.k === "d") p.classList.add("dub");
      p.addEventListener("click", () => { audio.currentTime = l.a + 0.01; if (audio.paused) audio.play(); });
      ccBody.appendChild(p);
    }
  };
  const paint = () => {
    if (!lines.length || !ccOn) return;
    const t = audio.currentTime;
    let i = lines.findIndex((l) => t < l.a + l.d);
    if (i < 0) i = lines.length - 1;
    if (i === idx) return;
    idx = i;
    showWindow(i);
  };

  const setCC = (on) => {
    ccOn = on; LS.set("listen-cc", on ? "1" : "0");
    $("#b-cc").classList.toggle("on", on);
    cc.hidden = !on;
    if (on) { cc.style.bottom = bar.offsetHeight + "px"; idx = -1; paint(); }
  };
  window.addEventListener("resize", () => { if (ccOn) cc.style.bottom = bar.offsetHeight + "px"; });

  /* ---- 原聲 ⇄ 翻譯：兩軌 block 一一對應，用 block + 比例換算時間 ---- */
  const mapTime = (t, from, to) => {
    if (!cap || !cap.db) return t;
    const a = from === "dub" ? cap.db : cap.ob, b = to === "dub" ? cap.db : cap.ob;
    let i = a.findIndex((x) => t < x[0] + x[1]); if (i < 0) i = a.length - 1;
    const e = a[i], o = b[i] || b[b.length - 1];
    const frac = e[1] > 0 ? Math.min(1, Math.max(0, (t - e[0]) / e[1])) : 0;
    return o[0] + frac * o[1];
  };
  const setMode = (m, keepTime = true) => {
    const e = EP[cur];
    if (m === "dub" && !e.dub) m = "orig";
    const playing = !audio.paused;
    const t = keepTime ? mapTime(audio.currentTime, mode, m) : 0;
    mode = m; LS.set("lesson-mode", m);
    $("#b-dub").classList.toggle("on", m === "dub");
    $("#b-dub").textContent = m === "dub" ? T.dub : T.orig;
    audio.addEventListener("loadedmetadata", () => { audio.currentTime = t; applyRate(); if (playing) audio.play(); }, { once: true });
    audio.src = m === "dub" ? e.dub : e.mp3; audio.load();
    $("#b-tot").textContent = ts(m === "dub" ? e.dub_duration : e.duration);
    buildScript(); paint();
  };

  /* ---- 語速 ---- */
  const rateSel = $("#b-rate");
  let rate = parseFloat(LS.get("lesson-rate")) || 1;
  const applyRate = () => { audio.playbackRate = rate; if ("preservesPitch" in audio) audio.preservesPitch = true; rateSel.value = String(rate); };
  rateSel.addEventListener("change", () => { rate = parseFloat(rateSel.value); LS.set("lesson-rate", String(rate)); applyRate(); });

  /* ---- 播某一集 ---- */
  const play = async (i, { resume = true, autoplay = true } = {}) => {
    if (i < 0 || i >= EP.length) return;
    const prev = cur; cur = i;
    const e = EP[i];
    bar.hidden = false;
    $("#b-ph").textContent = e.title || "";
    const bi = $("#b-img"); bi.hidden = true;
    if (e.yt_thumb || e.thumb) { bi.onerror = () => { bi.hidden = true; }; bi.onload = () => { bi.hidden = false; }; bi.src = e.yt_thumb || e.thumb; }
    $("#b-title").textContent = e.title; $("#b-title").href = e.plan;
    $("#b-src").hidden = !e.url; if (e.url) $("#b-src").href = e.url;
    $("#b-dub").hidden = !e.dub;
    try { history.replaceState(null, "", "#" + e.id); } catch (_) {}
    if (prev >= 0) paintCard(prev); paintCard(i);
    cap = await loadCap(e);
    if (cur !== i) return;
    const want = LS.get("lesson-mode") === "dub" && e.dub ? "dub" : "orig";
    mode = want; $("#b-dub").classList.toggle("on", want === "dub"); $("#b-dub").textContent = want === "dub" ? T.dub : T.orig;
    const pos = resume ? (parseFloat(LS.get("listen-pos:" + e.id)) || 0) : 0;
    const start = (want === "dub" ? mapTime(pos, "orig", "dub") : pos);
    audio.addEventListener("loadedmetadata", () => { audio.currentTime = start; applyRate(); if (autoplay) audio.play().catch(() => {}); }, { once: true });
    audio.src = want === "dub" ? e.dub : e.mp3; audio.load();
    $("#b-tot").textContent = ts(want === "dub" ? e.dub_duration : e.duration);
    buildScript(); if (ccOn) setCC(true);
    if ("mediaSession" in navigator) {
      navigator.mediaSession.metadata = new MediaMetadata({ title: e.title, artist: e.channel || "", artwork: e.yt_thumb ? [{ src: e.yt_thumb }] : [] });
      navigator.mediaSession.setActionHandler("previoustrack", () => play(cur - 1));
      navigator.mediaSession.setActionHandler("nexttrack", () => play(cur + 1));
      navigator.mediaSession.setActionHandler("seekbackward", () => { audio.currentTime -= 15; });
      navigator.mediaSession.setActionHandler("seekforward", () => { audio.currentTime += 15; });
    }
  };

  /* ---- 進度：每 5 秒記一次；播完標 done、自動接下一集 ---- */
  const savePos = () => {
    if (cur < 0) return;
    const t = mode === "dub" ? mapTime(audio.currentTime, "dub", "orig") : audio.currentTime;   // 一律存原聲軌的秒數
    LS.set("listen-pos:" + EP[cur].id, String(Math.floor(t)));
  };
  audio.addEventListener("timeupdate", () => {
    $("#b-cur").textContent = ts(audio.currentTime);
    if (audio.duration) $("#b-seek").value = Math.round(1000 * audio.currentTime / audio.duration);
    paint();
    if (Date.now() - lastSave > 5000) { lastSave = Date.now(); savePos(); paintCard(cur); }
  });
  audio.addEventListener("pause", () => { savePos(); paintCard(cur); $('[data-act="toggle"]').textContent = "▶"; });
  audio.addEventListener("play", () => { $('[data-act="toggle"]').textContent = "⏸"; });
  audio.addEventListener("ended", () => {
    LS.set("listen-done:" + EP[cur].id, "1"); LS.del("listen-pos:" + EP[cur].id); paintCard(cur);
    if (cur + 1 < EP.length) play(cur + 1);
  });
  $("#b-seek").addEventListener("input", (ev) => { if (audio.duration) audio.currentTime = audio.duration * ev.target.value / 1000; });

  /* ---- 按鈕 ---- */
  document.addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-act]"); if (!b) return;
    const act = b.dataset.act, card = b.closest(".ep");
    if (act === "play" && card) {
      const i = +card.dataset.i;
      if (i === cur) { audio.paused ? audio.play() : audio.pause(); } else play(i);
      return;
    }
    if (cur < 0) return;
    if (act === "toggle") audio.paused ? audio.play() : audio.pause();
    else if (act === "back") audio.currentTime = Math.max(0, audio.currentTime - 15);
    else if (act === "fwd") audio.currentTime += 15;
    else if (act === "prev") play(cur - 1);
    else if (act === "next") play(cur + 1);
    else if (act === "dub") setMode(mode === "dub" ? "orig" : "dub");
    else if (act === "cc") setCC(!ccOn);
  });
  document.addEventListener("keydown", (ev) => {
    if (cur < 0 || ev.target.matches("input,select,textarea")) return;
    if (ev.key === " ") { ev.preventDefault(); audio.paused ? audio.play() : audio.pause(); }
    else if (ev.key === "ArrowLeft") audio.currentTime = Math.max(0, audio.currentTime - 15);
    else if (ev.key === "ArrowRight") audio.currentTime += 15;
    else if (ev.key === "d" || ev.key === "D") { if (EP[cur].dub) setMode(mode === "dub" ? "orig" : "dub"); }
    else if (ev.key === "c" || ev.key === "C") setCC(!ccOn);
  });
  window.addEventListener("beforeunload", savePos);

  /* ---- 網址帶 #id 就直接打開那一集（不自動播，行動裝置不給自動播） ---- */
  const hashId = location.hash.slice(1);
  const hi = EP.findIndex((e) => e.id === hashId);
