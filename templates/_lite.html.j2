{# 不用 mermaid 的輕量頁（listen.html / notes.html 共用）：跟 _base.html.j2 同一套配色與字體，
   但沒有 CDN 依賴，離線、手機、file:// 都能開。 #}
<!doctype html>
<html lang="{{ S.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  :root { --fg:#1f2328; --muted:#59636e; --bg:#fff; --card:#f6f8fa; --line:#d0d7de; --accent:#0969da; --overlay:rgba(0,0,0,.85);
          --wrong:#cf222e; --wrong-bg:#ffebe9; --debat:#bc4c00; --debat-bg:#fff1e5; --ok:#1a7f37; }
  @media (prefers-color-scheme: dark) {
    :root { --fg:#e6edf3; --muted:#9198a1; --bg:#0d1117; --card:#161b22; --line:#30363d; --accent:#4493f8; --overlay:rgba(0,0,0,.9);
            --wrong:#ff7b72; --wrong-bg:#3c1618; --debat:#f0883e; --debat-bg:#3a2210; --ok:#3fb950; }
  }
  body { margin:0; padding:1.4rem 1rem; background:var(--bg); color:var(--fg);
         font:16px/1.7 system-ui, "Noto Sans TC", sans-serif; }
  main { max-width: 820px; margin: 0 auto; }
  h1 { font-size:1.7rem; margin:.2rem 0 .3rem; }
  h2 { border-bottom:1px solid var(--line); padding-bottom:.3rem; margin-top:2.2rem; }
  .muted { color:var(--muted); font-size:.9rem; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:1rem 1.2rem; margin:1rem 0; }
  a { color:var(--accent); }
  code { background:var(--card); padding:.1rem .35rem; border-radius:4px; }
  .topnav { display:flex; gap:.4rem 1rem; flex-wrap:wrap; font-size:.9rem; margin:0 0 1rem; }
  .topnav a { text-decoration:none; color:var(--muted); } .topnav a.on { color:var(--fg); font-weight:700; }
  .stats { display:flex; gap:1.2rem; flex-wrap:wrap; color:var(--muted); font-size:.9rem; margin:.2rem 0 1rem; }
{% block css %}{% endblock %}
</style>
</head>
<body>
{% block body %}{% endblock %}
{% block json %}{% endblock %}
<script>
{% block js %}{% endblock %}
</script>
</body>
</html>
